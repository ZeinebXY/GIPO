# Copy this to .env for local dev. On Railway, set these as project Variables instead.

# Long random string — used to sign JWTs. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173

# SQLite by default. On Railway, add a Postgres plugin and point this at it
# for data that survives redeploys, e.g.:
# DATABASE_URL=postgresql://user:pass@host:5432/railway
DATABASE_URL=sqlite:///./gipo.db
